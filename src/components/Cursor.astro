    place-items: center;
    width: clamp-fluid(30, 50);
    aspect-ratio: 115 / 108;
    border-radius: 100%;

    .lantern-inner {
      position: relative;
      display: grid;
      place-items: center;
      width: 100%;
      height: 100%;
      background-color: var(--color);
      border-radius: inherit;
      transform-origin: top;
      transition: box-shadow 0.4s var(--ease-smooth);
      animation: swing 5.2s ease-in-out -2.1s infinite alternate forwards;

      &::after {
        content: '';
        position: absolute;
        bottom: 0;
        z-index: 1;
        width: 100%;
        height: 100%;
        background-image: radial-gradient(
          circle at 50% -100%,
          var(--color) 0%,
          var(--color) 55%,
          var(--color-dark) 55%,
          var(--color-dark) 56%,
          var(--color) 56%,
          var(--color) 63%,
          var(--color-dark) 63%,
          var(--color-dark) 64%,
          var(--color) 64%,
          var(--color) 73%,
          var(--color-dark) 73%,
          var(--color-dark) 74%,
          var(--color) 74%,
          var(--color) 82%,
          var(--color-dark) 82%,
          var(--color-dark) 83%,
          var(--color) 83%,
          var(--color) 90%,
          var(--color-dark) 90%,
          var(--color-dark) 91%,
          var(--color) 91%,
          var(--color) 100%
        );
        border-radius: inherit;
      }
    }

    .lantern-top,
    .lantern-bottom {
      position: absolute;
      top: to-rem(-2);
      left: 50%;
      translate: -50% 0;
      z-index: 2;
      display: block;
      width: 30%;
      height: 6%;
      background-color: var(--color-dark);
      border-radius: 20%;
    }

