      0
    );
    transition:
      opacity 0.4s var(--ease-smooth),
      --color 0.4s var(--ease-smooth),
      --color-dark 0.4s var(--ease-smooth);

    &.is-active {
      opacity: 1;
    }

    &.is-hover {
      .lantern-inner {
        box-shadow: 0 0 to-rem(50) color(from var(--color) srgb r g b / 0.8);
      }
    }

    @include has-hover {
      display: block;
    }
  }

  .lantern {
