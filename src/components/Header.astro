---
import { Image } from 'astro:assets';

import { header } from '../content/globals';

import Socials from './Socials.astro';
---

<script>
  import { scrollStart } from '../scripts/scroll.ts';

  const header = document.querySelector('[data-js="header"]');
  const menuDesktop = document.querySelector('[data-js="nav-desktop"]');
  const linksDesktop = menuDesktop?.querySelectorAll('a');
  const menuMobile = document.querySelector('[data-js="menu-mobile"]');
  const menuTrigger = menuMobile?.querySelector('[data-js="menu-trigger"]');
  const linksMobile = menuMobile?.querySelectorAll('a');

  menuTrigger?.addEventListener('click', () => {
    menuMobile?.classList.toggle('is-open');
  });

  linksMobile?.forEach((link) => {
    link.addEventListener('click', () => {
      menuMobile?.classList.remove('is-open');
    });
  });

  const initLanternObserver = () => {
    const sections: Element[] = [];

    linksDesktop?.forEach((link) => {
      const section = document.querySelector(link.hash);
      if (section) sections.push(section);
    });

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const sectionId = entry.target.id;

          if (entry.isIntersecting) {
            linksDesktop?.forEach((link) => link.classList.remove('is-active'));

            linksDesktop?.forEach((link) => {
              if (link.hash === `#${sectionId}`) {
                link.classList.add('is-active');
              }
            });
          } else {
            linksDesktop?.forEach((link) => {
              if (link.hash === `#${sectionId}`) {
                link.classList.remove('is-active');
              }
            });
          }
        });
      },
      {
        rootMargin: '-20% 0% -60% 0%',
        threshold: 0.1,
      },
    );

    sections.forEach((section) => observer.observe(section));
  };

  initLanternObserver();

  window.addEventListener('load', () => {
    if (window.innerWidth < 1024) {
      window.dispatchEvent(new Event('intro:done'));
      scrollStart();
    } else {
      header?.classList.add('animate');
      linksDesktop?.forEach((link, i) => {
        setTimeout(
          () => {
            link.classList.add('is-active');

            setTimeout(() => {
              link.classList.remove('is-active');

              if (i === linksDesktop.length - 1) {
                window.dispatchEvent(new Event('intro:done'));
                scrollStart();
              }
            }, 800);
          },
          400 + 100 * i,
        );
      });
    }
  });
</script>

<header data-js="header">
  <div class="container">
    <a href="/" class="logo" aria-label="Zur Startseite" data-inview-manual>
      <Image src={header.logo.image} alt={header.logo.alt} />
    </a>
    <nav class="nav-desktop" data-js="nav-desktop">
      <svg class="string" viewBox="0 0 1434 135" fill="none" aria-hidden="true">
        <path
          d="M2 103C373 145 868.5 167 1432 2"
          stroke="#FAFAFA"
          stroke-width="3"
          stroke-linecap="round"
          pathLength="1"></path>
      </svg>
      <ul class="lanterns">
        <li class="lantern">
          <div class="lantern-inner">
            <span class="lantern-top"></span>
            <a href="/#shopping" class="lantern-link">Shopping</a>
            <span class="lantern-bottom"></span>
          </div>
        </li>
        <li class="lantern">
          <div class="lantern-inner">
            <span class="lantern-top"></span>
            <a href="/#living" class="lantern-link">Living</a>
            <span class="lantern-bottom"></span>
          </div>
        </li>
        <li class="lantern">
          <div class="lantern-inner">
            <span class="lantern-top"></span>
            <a href="/#kulinarik" class="lantern-link">Kulinarik</a>
            <span class="lantern-bottom"></span>
          </div>
        </li>
        <li class="lantern">
          <div class="lantern-inner">
            <span class="lantern-top"></span>
            <a href="/#office" class="lantern-link">Office</a>
            <span class="lantern-bottom"></span>
          </div>
        </li>
        <li class="lantern">
          <div class="lantern-inner">
            <span class="lantern-top"></span>
            <a href="/#newsevents" class="lantern-link">Events</a>
            <span class="lantern-bottom"></span>
          </div>
        </li>
      </ul>
    </nav>
    <div class="socials" data-inview-manual>
      <Socials />
    </div>
    <div class="menu-mobile" data-js="menu-mobile">
      <button class="lantern" data-js="menu-trigger">
        <span class="lantern-inner">
          <span class="lantern-top"></span>
          <span class="lantern-link">Menu</span>
          <span class="lantern-bottom"></span>
        </span>
      </button>
      <nav>
        <ul class="lanterns">
          <li class="lantern">
            <div class="lantern-inner">
              <span class="lantern-top"></span>
              <a href="/#shopping" class="lantern-link">Shopping</a>
              <span class="lantern-bottom"></span>
            </div>
          </li>
          <li class="lantern">
            <div class="lantern-inner">
              <span class="lantern-top"></span>
              <a href="/#living" class="lantern-link">Living</a>
              <span class="lantern-bottom"></span>
            </div>
          </li>
          <li class="lantern">
            <div class="lantern-inner">
              <span class="lantern-top"></span>
              <a href="/#kulinarik" class="lantern-link">Kulinarik</a>
              <span class="lantern-bottom"></span>
            </div>
          </li>
          <li class="lantern">
            <div class="lantern-inner">
              <span class="lantern-top"></span>
              <a href="/#office" class="lantern-link">Office</a>
              <span class="lantern-bottom"></span>
            </div>
          </li>
          <li class="lantern">
            <div class="lantern-inner">
              <span class="lantern-top"></span>
              <a href="/#newsevents" class="lantern-link">Events</a>
              <span class="lantern-bottom"></span>
            </div>
          </li>
        </ul>
      </nav>
    </div>
  </div>
</header>

<style lang="scss">
  header {
    position: fixed;
    top: 0;
    z-index: var(--zi-header);
    width: calc(100% - var(--scroll-bar-width, 0px));
  }

  a {
    text-decoration: none;
  }

  .container {
    display: flex;
    justify-content: space-between;
  }

  .logo,
  .socials {
    position: relative;
    z-index: 1;
    margin-block: to-rem(32);
  }

  .logo {
    width: clamp-fluid(80, 150);
  }

  .socials {
    display: none;
  }

  .lantern {
    display: grid;
    place-items: center;
    width: clamp-fluid(100, 115);
    aspect-ratio: 115 / 108;
    border-radius: 100%;

    &:nth-child(1) {
      .lantern-inner {
        --color: var(--c-pink);
        --color-dark: var(--c-pink-dark);
        animation: swing 5.6s ease-in-out -2.9s infinite alternate forwards;
      }
    }

    &:nth-child(2) {
      .lantern-inner {
        --color: var(--c-green);
        --color-dark: var(--c-green-dark);
        animation: swing 4.6s ease-in-out -1.3s infinite alternate forwards;
      }
    }

    &:nth-child(3) {
      .lantern-inner {
        --color: var(--c-orange);
        --color-dark: var(--c-orange-dark);
        animation: swing 5.2s ease-in-out -2.1s infinite alternate forwards;
      }
    }

    &:nth-child(4) {
      .lantern-inner {
        --color: var(--c-blue);
        --color-dark: var(--c-blue-dark);
        animation: swing 6s ease-in-out -3.9s infinite alternate forwards;
      }
    }

    &:nth-child(5) {
      .lantern-inner {
        --color: var(--c-yellow);
        --color-dark: var(--c-yellow-dark);
        animation: swing 4.8s ease-in-out -1.1s infinite alternate forwards;
      }
    }

    .lantern-inner,
    .lantern-link {
      display: grid;
      place-items: center;
      width: 100%;
      height: 100%;
      border-radius: inherit;
      font-size: to-rem(16);
      font-weight: var(--fw-bold);
      text-transform: uppercase;
      color: var(--c-dark);
      white-space: nowrap;
    }

    .lantern-inner {
      position: relative;
      background-color: var(--color);
      transform-origin: top;

      &::after {
        content: '';
        position: absolute;
        bottom: 0;
        z-index: 1;
        width: 100%;
        height: 100%;
        background: radial-gradient(
          circle at 50% -100%,
          var(--color) 0%,
          var(--color) 55%,
          var(--color-dark) 55%,
          var(--color-dark) 56%,
          var(--color) 56%,
          var(--color) 63%,
          var(--color-dark) 63%,
          var(--color-dark) 64%,
          var(--color) 64%,
          var(--color) 82%,
          var(--color-dark) 82%,
          var(--color-dark) 83%,
          var(--color) 83%,
          var(--color) 90%,
          var(--color-dark) 90%,
          var(--color-dark) 91%,
          var(--color) 91%,
          var(--color) 100%
        );
        border-radius: inherit;
      }
    }

    .lantern-link {
      z-index: 10;
      display: grid;
      place-items: center;
      width: 100%;
      height: 100%;
      border-radius: inherit;
    }

    .lantern-top,
    .lantern-bottom {
      position: absolute;
      top: to-rem(-2);
      left: 50%;
      translate: -50% 0;
      z-index: 2;
      display: block;
      width: 30%;
      height: 6%;
      background-color: var(--color-dark);
      border-radius: 20%;
    }

    .lantern-bottom {
      top: auto;
      bottom: to-rem(-2);
    }
  }

  .nav-desktop {
    display: none;
    position: relative;
    flex-grow: 1;
    align-self: flex-start;
    overflow-x: clip;
    scale: 1.25;
    translate: 0 to-rem(200);
    transition:
      scale 0.7s var(--ease-smooth),
      translate 0.7s var(--ease-smooth);

    .string {
      width: 100%;

      path {
        stroke-dasharray: 1;
        stroke-dashoffset: 1;
        transition: stroke-dashoffset 0.8s var(--ease-smooth);
      }
    }

    .lanterns {
      display: flex;
      justify-content: space-around;
      list-style: none;
    }

    .lantern {
      --fluid-min: 1024;
      --fluid-max: 1920;

      opacity: 0;
      transition: opacity 0.4s var(--ease-smooth);

      &:nth-child(1) {
        translate: 0 clamp-fluid(-7, -19);
        rotate: 5deg;
        transition-delay: 0.15s;
      }

      &:nth-child(2) {
        translate: 0 clamp-fluid(0, -2);
        rotate: 1deg;
        transition-delay: 0.2s;
      }

      &:nth-child(3) {
        translate: 0 clamp-fluid(-2, -8);
        rotate: -4deg;
        transition-delay: 0.25s;
      }

      &:nth-child(4) {
        translate: 0 clamp-fluid(-17, -42);
        rotate: -8deg;
        transition-delay: 0.3s;
      }

      &:nth-child(5) {
        translate: 0 clamp-fluid(-44, -104);
        rotate: -13deg;
        transition-delay: 0.35s;
      }
    }

    .lantern-inner {
      --color: var(--c-pink);
      --color-dark: var(--c-pink-dark);

      transition: box-shadow var(--ease-smooth) 0.4s;

      @include has-hover {
        &:hover,
        &:has(.lantern-link.is-active) {
          box-shadow: 0 0 to-rem(50) color(from var(--color) srgb r g b / 0.7);
        }
      }
    }
  }

  :global(.has-scrolled):not(.scrolling-up) .nav-desktop {
    scale: 1;
    translate: 0;
  }

  .menu-mobile {
    position: relative;
    margin-top: to-rem(32);

    // TODO: more dynamic string
    &::after {
      content: '';
      position: absolute;
      top: to-rem(-32);
      left: 50%;
      z-index: -1;
      width: to-rem(2);
      height: calc(100% + to-rem(16));
      background-color: var(--c-light);
      transform-origin: top;
      transition: scale 0.7s var(--ease-smooth);
    }

    > .lantern {
      &:first-child {
        position: relative;
        z-index: 10;

        .lantern-inner {
          --color: var(--c-purple);
          --color-dark: var(--c-purple-dark);
        }
      }
    }

    nav {
      position: absolute;
    }

    .lanterns {
      padding-top: to-rem(16);
      display: flex;
      flex-direction: column;
      gap: to-rem(16);

      .lantern {
        transition: translate 0.7s var(--ease-smooth);

        a {
          opacity: 0;
          transition-delay: 0.7s;
        }

        &:nth-child(1) {
          z-index: 5;
          translate: 0 calc(100% * -1 - to-rem(16));
        }

        &:nth-child(2) {
          z-index: 4;
          translate: 0 calc(100% * -2 - to-rem(16) * 2);
        }

        &:nth-child(3) {
          z-index: 3;
          translate: 0 calc(100% * -3 - to-rem(16) * 3);
        }

        &:nth-child(4) {
          z-index: 2;
          translate: 0 calc(100% * -4 - to-rem(16) * 4);
        }

        &:nth-child(5) {
          z-index: 1;
          translate: 0 calc(100% * -5 - to-rem(16) * 5);
        }
      }
    }

    &.is-open {
      &::after {
        scale: 1 5;
      }

      .lanterns {
        .lantern {
          translate: 0 0;

          a {
            opacity: 1;
            transition-delay: 0s;
          }
        }
      }
    }
  }

  header.animate {
    .nav-desktop {
      .string {
        path {
          stroke-dashoffset: 0;
        }
      }

      .lantern {
        opacity: 1;
      }
    }
  }

  @keyframes swing {
    0% {
      rotate: -6deg;
    }

    30% {
      rotate: 4deg;
    }

    70% {
      rotate: -3deg;
    }

    100% {
      rotate: 7deg;
    }
  }

  @media (min-width: 1024px) {
    .nav-desktop,
    .socials {
      display: block;
    }

    .menu-mobile {
      display: none;
    }
  }
</style>
