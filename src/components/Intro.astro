---
import type { CollectionEntry } from 'astro:content';

type ModuleIntro = CollectionEntry<'pageHome'>['data']['moduleIntro'];

interface Props {
  fields: ModuleIntro;
}

import { marked } from 'marked';

const { fields } = Astro.props;

const parsedContent = await marked(fields.content);
---

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger, Flip } from 'gsap/all';

  const mm = gsap.matchMedia();

  gsap.registerPlugin(ScrollTrigger, Flip);

  const intro = document.querySelector('[data-js="intro"]');
  const video = intro?.querySelector('video');

  mm.add('(max-width: 1023px)', () => {
    if (intro && video) {
      const state = Flip.getState(video);

      intro.classList.add('final');

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: intro,
          start: 'top top',
          endTrigger: video,
          end: 'top 30%',
          scrub: true,
        },
      });

      tl.add(
        Flip.from(state, {
          scale: true,
        }),
      );
    }
  });

  mm.add('(min-width: 1024px)', () => {
    if (intro && video) {
      const state = Flip.getState(video);

      intro.classList.add('final');

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: intro,
          start: 'top top',
          end: 'bottom 50%',
          scrub: true,
          pin: true,
        },
      });

      tl.add(
        Flip.from(state, {
          scale: true,
        }),
      );
    }
  });
</script>

<div class="intro container" data-js="intro">
  <div class="media">
    <video
      src={fields.video}
      muted
      loop
      autoplay
      playsinline
      disablepictureinpicture
      data-inview-no-offset></video>
  </div>
  <h1>
    <strong data-inview-no-offset>Die Waldstraße</strong>
    <br />
    <span data-inview>Karlsruhe</span>
  </h1>
  <div class="content-block richtext" set:html={parsedContent} data-inview />
</div>

<style lang="scss">
  .intro {
    &.final {
      video {
        width: 100%;
        margin-bottom: to-rem(32);
      }
    }
  }

  .media {
    display: grid;
    justify-items: end;
    align-items: end;
    height: 65vh;
  }

  video {
    width: 75%;
    border-radius: var(--br-default);
  }

  h1 {
    --fluid-min: 375;
    --fluid-max: 1920;

    margin-top: clamp-fluid(48, 128);
    font-size: clamp-fluid(35, 195);
    font-weight: var(--fw-light);
    line-height: 1;
    text-transform: uppercase;
    text-align: center;

    strong {
      font-weight: var(--fw-black);
    }
  }

  .richtext {
    margin-top: clamp-fluid(64, 128);
    text-align: center;
  }

  @media (min-width: 1024px) {
    .intro {
      &.final {
        .media {
          justify-items: center;
        }

        video {
          width: max(70%, to-rem(560));
        }
      }
    }

    .media {
      height: calc(100vh - (clamp-fluid(38, 247) * 0.65));
    }

    video {
      width: max(30%, to-rem(400));
    }

    h1 {
      margin-top: 0;
    }
  }
</style>
