---
import type { CollectionEntry } from 'astro:content';

type ModuleIntro = Extract<
  CollectionEntry<'pageHome'>['data']['sections'][0]['modules'][0],
  { type: 'moduleIntro' }
>;

interface Props {
  fields: ModuleIntro;
}

import { marked } from 'marked';

const { fields } = Astro.props;

const parsedContent = await marked(fields.content);
---

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger, Flip } from 'gsap/all';

  gsap.registerPlugin(ScrollTrigger, Flip);

  const intro = document.querySelector('[data-js="intro"]');
  const video = intro?.querySelector('video');

  if (intro && video) {
    const state = Flip.getState(video);

    intro.classList.add('final');

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: intro,
        start: 'top top',
        end: 'bottom 50%',
        scrub: true,
        pin: true,
      },
    });

    tl.add(
      Flip.from(state, {
        scale: true,
      }),
    );
  }
</script>

<div class="intro container" data-module={fields.type} data-js="intro">
  <div class="media">
    <video
      src={fields.video}
      muted
      loop
      autoplay
      playsinline
      disablepictureinpicture></video>
  </div>
  <h1>
    <strong>Die Waldstraße</strong>
    <br />
    <span data-inview>Karlsruhe</span>
  </h1>
  <div class="content-block richtext" set:html={parsedContent} data-inview />
</div>

<style lang="scss">
  .intro {
    margin-top: clamp-fluid(-60, -120);

    &.final {
      .media {
        justify-items: center;

        video {
          width: max(70%, to-rem(560));
        }
      }
    }
  }

  .media {
    display: grid;
    justify-items: end;
    align-items: end;
    height: calc(100vh - (clamp-fluid(38, 247) * 0.65));
  }

  video {
    width: max(30%, to-rem(400));
    border-radius: to-rem(24);
  }

  h1 {
    --fluid-min: 375;
    --fluid-max: 1920;

    font-size: clamp-fluid(30, 195);
    font-weight: var(--fw-light);
    line-height: 1;
    text-transform: uppercase;
    text-align: center;

    strong {
      font-weight: var(--fw-black);
    }
  }

  .richtext {
    margin-top: clamp-fluid(64, 128);
    text-align: center;
  }
</style>
