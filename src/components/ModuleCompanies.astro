---
import type { CollectionEntry } from 'astro:content';

type ModuleCompanies = CollectionEntry<'pageHome'>['data']['moduleCompanies'];

interface Props {
  fields: ModuleCompanies;
}

import { Image } from 'astro:assets';

import mapImage from '../content/map.webp';

const { fields } = Astro.props;
---

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/all';

  import { lenis } from '../scripts/scroll';

  gsap.registerPlugin(ScrollTrigger);

  const backgroundImage: HTMLElement | null = document.querySelector(
    '[data-js="background-image"]',
  );
  const pinnedCard: HTMLElement | null = document.querySelector(
    '[data-js="pinned-card"]',
  );
  const maskedContent: HTMLElement | null = document.querySelector(
    '[data-js="masked-content"]',
  );

  if (backgroundImage && pinnedCard && maskedContent) {
    gsap
      .timeline({
        scrollTrigger: {
          trigger: backgroundImage,
          start: 'top 50%',
          end: 'top top',
          scrub: true,
        },
      })
      .to(backgroundImage, {
        scale: 1.5,
        ease: 'power1.inOut',
      });

    lenis.on('scroll', () => {
      const pinnedCartRect = pinnedCard.getBoundingClientRect();
      const maskedContentRect = maskedContent.getBoundingClientRect();

      const dist = pinnedCartRect.top - maskedContentRect.top;
      maskedContent.style.setProperty('--pinned-card-top', `${dist}px`);

      const maxScrollDistance =
        maskedContentRect.height - pinnedCartRect.height;

      const scrollProgress =
        100 -
        Math.max(0, Math.min(100, (Math.abs(dist) / maxScrollDistance) * 100));

      pinnedCard.style.setProperty('--clip-progress', `${scrollProgress}%`);
    });
  }
</script>

<div class="companies module">
  <div class="background-wrap">
    <Image
      src={mapImage}
      alt="Karte von Karlsruhe mit der Waldstraße visuell hervorgehoben"
      class="background"
      data-js="background-image"
    />
  </div>
  <div class="container">
    <div class="card-container">
      <div
        class="card"
        style={`
          --progress-stop-1: ${((fields.shopping.length / (fields.shopping.length + fields.living.length + fields.kulinarik.length + fields.office.length)) * 100).toFixed(0)}%;
          --progress-stop-2: ${(((fields.shopping.length + fields.living.length) / (fields.shopping.length + fields.living.length + fields.kulinarik.length + fields.office.length)) * 100).toFixed(0)}%;
          --progress-stop-3: ${(((fields.shopping.length + fields.living.length + fields.kulinarik.length) / (fields.shopping.length + fields.living.length + fields.kulinarik.length + fields.office.length)) * 100).toFixed(0)}%;
        `}
        data-js="pinned-card"
      >
      </div>
      <div class="content" data-js="masked-content">
        <div id="shopping" class="group">
          <h2 class="group-title" data-inview>Shopping</h2>
          <div class="logos">
            {
              fields.shopping.map((company) => (
                <div class="logo">
                  <a
                    href={company.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-inview
                  >
                    <Image src={company.image.image} alt={company.image.alt} />
                  </a>
                  <span class="category" data-inview>
                    {company.category}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
        <div id="living" class="group">
          <h2 class="group-title" data-inview>Living</h2>
          <div class="logos">
            {
              fields.living.map((company) => (
                <div class="logo">
                  <a
                    href={company.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-inview
                  >
                    <Image src={company.image.image} alt={company.image.alt} />
                  </a>
                  <span class="category" data-inview>
                    {company.category}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
        <div id="kulinarik" class="group">
          <h2 class="group-title" data-inview>Kulinarik</h2>
          <div class="logos">
            {
              fields.kulinarik.map((company) => (
                <div class="logo">
                  <a
                    href={company.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-inview
                  >
                    <Image src={company.image.image} alt={company.image.alt} />
                  </a>
                  <span class="category" data-inview>
                    {company.category}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
        <div id="office" class="group">
          <h2 class="group-title" data-inview>Office</h2>
          <div class="logos">
            {
              fields.office.map((company) => (
                <div class="logo">
                  <a
                    href={company.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-inview
                  >
                    <Image src={company.image.image} alt={company.image.alt} />
                  </a>
                  <span class="category" data-inview>
                    {company.category}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style lang="scss">
  .companies {
    position: relative;
    padding-top: 18svh;
    padding-bottom: 2svh;
  }

  .background-wrap {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: clip;
  }

  .background {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100svh;
    object-fit: cover;
    object-position: left bottom;
    transform-origin: left bottom;
  }

  .card-container {
    display: grid;
    width: min(100%, 650px);
    margin-left: auto;
    color: var(--c-dark);
  }

  .card,
  .content {
    grid-column: 1 / 1;
    grid-row: 1 / 1;
  }

  .card {
    position: sticky;
    top: 18svh;
    height: 80svh;
    background-color: var(--c-light);
    border-radius: var(--br-default);

    &::before,
    &::after {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      width: clamp-fluid(16, 32);
      height: 100%;
      background: linear-gradient(
        to bottom,
        var(--c-pink) 0%,
        var(--c-pink) var(--progress-stop-1, 25%),
        var(--c-green) var(--progress-stop-1, 25%),
        var(--c-green) var(--progress-stop-2, 50%),
        var(--c-orange) var(--progress-stop-2, 50%),
        var(--c-orange) var(--progress-stop-3, 75%),
        var(--c-blue) var(--progress-stop-3, 75%),
        var(--c-blue) 100%
      );
      border-radius: inherit;
      border-top-left-radius: 0;
      border-bottom-left-radius: 0;
    }

    &::before {
      opacity: 0.5;
    }

    &::after {
      clip-path: inset(0 0 var(--clip-progress, 0%) 0);
    }
  }

  .content {
    z-index: 1;
    padding: clamp-fluid(24, 64);
    padding-right: clamp-fluid(32, 64);
    clip-path: rect(
      var(--pinned-card-top, 0px) auto calc(80svh + var(--pinned-card-top, 0px))
        0
    );
  }

  .group {
    + .group {
      margin-top: clamp-fluid(48, 64);
    }
  }

  .group-title {
    font-size: clamp-fluid(32, 64);
    text-transform: uppercase;
  }

  .logos {
    margin-top: clamp-fluid(32, 48);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: clamp-fluid(32, 48) clamp-fluid(16, 32);
  }

  .logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
  }

  .category {
    margin-top: clamp-fluid(8, 16);
    font-size: clamp-fluid(14, 18);
    font-weight: var(--fw-light);
    line-height: 1.1;
    text-transform: uppercase;
    text-align: center;
  }
</style>
