---
import type { CollectionEntry } from 'astro:content';

type ModuleCompanies = CollectionEntry<'pageHome'>['data']['moduleCompanies'];

interface Props {
  fields: ModuleCompanies;
}

import { Image } from 'astro:assets';

import MapImage from '@content/map.svg';

const { fields } = Astro.props;
---

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/all';

  import { lenis } from '../scripts/scroll';

  gsap.registerPlugin(ScrollTrigger);

  const map: HTMLElement | null = document.querySelector('[data-js="map"]');
  const pinnedCard: HTMLElement | null = document.querySelector(
    '[data-js="pinned-card"]',
  );
  const maskedContent: HTMLElement | null = document.querySelector(
    '[data-js="masked-content"]',
  );

  if (map && pinnedCard && maskedContent) {
    window.addEventListener('load', () => {
      const progressStop1 = parseInt(
        pinnedCard.style.getPropertyValue('--progress-stop-1'),
      );
      const progressStop2 = parseInt(
        pinnedCard.style.getPropertyValue('--progress-stop-2'),
      );
      const progressStop3 = parseInt(
        pinnedCard.style.getPropertyValue('--progress-stop-3'),
      );

      const pins: NodeListOf<HTMLElement> =
        map.querySelectorAll('[data-js^="pin-"]');

      let currentSection = '';

      const resetPins = () => {
        return gsap.to(pins, {
          scale: 0,
          autoAlpha: 0,
          transformOrigin: 'center bottom',
          duration: 0.2,
          stagger: 0.02,
          ease: 'power2.inOut',
        });
      };

      const animatePins = (pins: HTMLElement[]) => {
        gsap.fromTo(
          pins,
          {
            scale: 0,
            autoAlpha: 0,
            transformOrigin: 'center bottom',
          },
          {
            scale: 1,
            autoAlpha: 1,
            transformOrigin: 'center bottom',
            duration: 0.3,
            stagger: 0.025,
          },
        );
      };

      resetPins();

      gsap
        .timeline({
          scrollTrigger: {
            trigger: map,
            start: 'top top',
            endTrigger: maskedContent,
            end: 'top 50%',
            scrub: true,
          },
        })
        .to(map, {
          scale: 1.5,
          ease: 'power1.inOut',
        });

      lenis.on('scroll', async () => {
        const pinnedCardRect = pinnedCard.getBoundingClientRect();
        const maskedContentRect = maskedContent.getBoundingClientRect();

        const dist = pinnedCardRect.top - maskedContentRect.top;
        maskedContent.style.setProperty('--pinned-card-top', `${dist}px`);

        const maxScrollDistance =
          maskedContentRect.height - pinnedCardRect.height;

        const scrollProgress = Math.max(
          0,
          Math.min(100, (Math.abs(dist) / maxScrollDistance) * 100),
        );

        pinnedCard.style.setProperty(
          '--clip-progress',
          `${100 - scrollProgress}%`,
        );

        if (window.innerWidth >= 1024) {
          let newSection = '';

          if (scrollProgress >= 100) {
            newSection = 'all';
          } else if (scrollProgress > progressStop3) {
            newSection = 'office';
          } else if (scrollProgress > progressStop2) {
            newSection = 'kulinarik';
          } else if (scrollProgress > progressStop1) {
            newSection = 'living';
          } else if (scrollProgress > 0) {
            newSection = 'shopping';
          } else {
            newSection = 'none';
          }

          if (newSection !== currentSection) {
            currentSection = newSection;

            window.dispatchEvent(
              new CustomEvent('ui:section-change', {
                detail: {
                  sectionId: currentSection === 'none' ? null : currentSection,
                },
              }),
            );

            if (newSection === 'all') {
              await resetPins();
              animatePins([...pins]);
            } else if (newSection === 'none') {
              resetPins();
            } else {
              await resetPins();
              animatePins(
                [...pins].filter(
                  (pin) => pin.dataset.js === `pin-${currentSection}`,
                ),
              );
            }
          }
        } else {
          if (pinnedCardRect.top < window.innerHeight && !currentSection) {
            animatePins([...pins]);
            currentSection = 'all';
          } else if (
            pinnedCardRect.top >= window.innerHeight &&
            currentSection !== ''
          ) {
            resetPins();
            currentSection = '';
          }
        }
      });
    });
  }
</script>

<div class="companies module">
  <div class="background-wrap">
    <MapImage
      aria-label="Karte von Karlsruhe mit der Waldstraße visuell hervorgehoben"
      class="background"
      data-js="map"
    />
  </div>
  <div class="container">
    <div class="card-container">
      <div
        class="card"
        style={`
          --progress-stop-1: ${((fields.shopping.length / (fields.shopping.length + fields.living.length + fields.kulinarik.length + fields.office.length)) * 100).toFixed(0)}%;
          --progress-stop-2: ${(((fields.shopping.length + fields.living.length) / (fields.shopping.length + fields.living.length + fields.kulinarik.length + fields.office.length)) * 100).toFixed(0)}%;
          --progress-stop-3: ${(((fields.shopping.length + fields.living.length + fields.kulinarik.length) / (fields.shopping.length + fields.living.length + fields.kulinarik.length + fields.office.length)) * 100).toFixed(0)}%;
        `}
        data-js="pinned-card"
      >
      </div>
      <div class="content" data-js="masked-content">
        <div id="shopping" class="group" style="--group-index: 0;">
          <h2 class="group-title" data-inview>Shopping</h2>
          <div class="logos">
            {
              fields.shopping.map((company) => (
                <div class="logo">
                  <a
                    href={company.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-inview
                  >
                    <Image src={company.image.image} alt={company.image.alt} />
                  </a>
                  <span class="category" data-inview>
                    {company.category}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
        <div id="living" class="group" style="--group-index: 1;">
          <h2 class="group-title" data-inview>Living</h2>
          <div class="logos">
            {
              fields.living.map((company) => (
                <div class="logo">
                  <a
                    href={company.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-inview
                  >
                    <Image src={company.image.image} alt={company.image.alt} />
                  </a>
                  <span class="category" data-inview>
                    {company.category}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
        <div id="kulinarik" class="group" style="--group-index: 2;">
          <h2 class="group-title" data-inview>Kulinarik</h2>
          <div class="logos">
            {
              fields.kulinarik.map((company) => (
                <div class="logo">
                  <a
                    href={company.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-inview
                  >
                    <Image src={company.image.image} alt={company.image.alt} />
                  </a>
                  <span class="category" data-inview>
                    {company.category}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
        <div id="office" class="group" style="--group-index: 3;">
          <h2 class="group-title" data-inview>Office</h2>
          <div class="logos">
            {
              fields.office.map((company) => (
                <div class="logo">
                  <a
                    href={company.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    data-inview
                  >
                    <Image src={company.image.image} alt={company.image.alt} />
                  </a>
                  <span class="category" data-inview>
                    {company.category}
                  </span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style lang="scss">
  [id] {
    scroll-margin-top: calc(20svh + var(--group-index, 0) * 10svh);
  }

  .companies {
    position: relative;
  }

  .background-wrap {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: clip;
  }

  .background {
    position: sticky;
    top: 0;
    width: 100%;
    height: 100svh;
    object-fit: cover;
    object-position: left bottom;
    transform-origin: to-rem(225) bottom;
  }

  .card-container {
    display: grid;
    width: min(100%, 650px);
    padding-top: 100svh;
    margin-left: auto;
    color: var(--c-dark);
  }

  .card,
  .content {
    grid-column: 1 / 1;
    grid-row: 1 / 1;
  }

  .card {
    position: sticky;
    top: 0;
    height: 100dvh;
    background-color: var(--c-light);
    border-radius: var(--br-default);

    &::before,
    &::after {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      width: clamp-fluid(16, 32);
      height: 100%;
      background: linear-gradient(
        to bottom,
        var(--c-pink) 0%,
        var(--c-pink) var(--progress-stop-1, 25%),
        var(--c-green) var(--progress-stop-1, 25%),
        var(--c-green) var(--progress-stop-2, 50%),
        var(--c-orange) var(--progress-stop-2, 50%),
        var(--c-orange) var(--progress-stop-3, 75%),
        var(--c-blue) var(--progress-stop-3, 75%),
        var(--c-blue) 100%
      );
      border-radius: inherit;
      border-top-left-radius: 0;
      border-bottom-left-radius: 0;
    }

    &::before {
      opacity: 0.5;
    }

    &::after {
      clip-path: inset(0 0 var(--clip-progress, 0%) 0);
    }
  }

  .content {
    z-index: 1;
    padding: clamp-fluid(24, 64);
    padding-right: clamp-fluid(32, 64);
  }

  .group {
    + .group {
      margin-top: clamp-fluid(80, 100);
    }
  }

  .group-title {
    font-size: clamp-fluid(32, 64);
    text-transform: uppercase;
  }

  .logos {
    margin-top: clamp-fluid(32, 48);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: clamp-fluid(36, 54) clamp-fluid(16, 32);
  }

  .logo {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;

    a {
      flex-grow: 1;
      display: grid;
      place-content: center;

      @include has-hover {
        &:hover img {
          scale: 0.9;
        }
      }
    }

    img {
      transition: scale 0.4s var(--ease-smooth);
    }
  }

  .category {
    margin-top: clamp-fluid(12, 24);
    font-size: clamp-fluid(14, 16);
    font-weight: var(--fw-light);
    line-height: 1.1;
    text-transform: uppercase;
    text-align: center;
  }

  @media (min-width: 1024px) {
    .companies {
      padding-top: 18svh;
      padding-bottom: 2svh;
    }

    .card {
      top: 18svh;
      height: 80dvh;
    }

    .content {
      clip-path: rect(
        var(--pinned-card-top, 0px) auto
          calc(80svh + var(--pinned-card-top, 0px)) 0
      );
    }
  }
</style>
