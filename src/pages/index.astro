---
import { getCollection } from 'astro:content';

import Layout from '../layouts/Layout.astro';
import ModuleIntro from '../components/ModuleIntro.astro';
import ModuleEvents from '../components/ModuleEvents.astro';

const [page] = await getCollection('pageHome');
---

<Layout>
  <main class="home">
    <section>
      <ModuleIntro fields={page.data.moduleIntro} />
    </section>
    <section id="newsevents" class="section">
      <ModuleEvents fields={page.data.moduleEvents} />
    </section>
  </main>
</Layout>
