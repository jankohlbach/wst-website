---
import { getCollection } from 'astro:content';

import Layout from '@layouts/Layout.astro';
import ModuleIntro from '@components/ModuleIntro.astro';
import ModuleEvents from '@components/ModuleEvents.astro';
import ModuleKeywords from '@components/ModuleKeywords.astro';
import ModuleCompanies from '@components/ModuleCompanies.astro';

const [page] = await getCollection('pageHome');
---

<Layout>
  <main class="home">
    <section>
      <ModuleIntro fields={page.data.moduleIntro} />
    </section>
    <section class="section">
      <ModuleCompanies fields={page.data.moduleCompanies} />
    </section>
    <section id="newsevents" class="section">
      <ModuleEvents fields={page.data.moduleEvents} />
      <ModuleKeywords fields={page.data.moduleKeywords} />
    </section>
  </main>
</Layout>
